{
  "name": "D365 F&O standard forms",
  "module": {
    "name": "D365 F&O",
    "description": "Standard data entities of D365 Finance & Operations. Fill in the environment URL, tenant and app registration.",
    "auth": {
      "type": "oauth2_client_credentials",
      "tokenUrl": "https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token",
      "clientId": "{{clientId}}",
      "clientSecret": "{{clientSecret}}",
      "scope": "{{baseUrl}}/.default"
    },
    "variables": {
      "baseUrl": "",
      "tenantId": "",
      "clientId": "",
      "clientSecret": ""
    },
    "headers": {}
  },
  "forms": [
    {
      "name": "Customers",
      "description": "Find customers and export them to Excel.",
      "icon": "customer",
      "category": "D365 F&O",
      "auth": {
        "type": "module"
      },
      "api": {
        "method": "GET",
        "url": "{{baseUrl}}/data/CustomersV3",
        "headers": {
          "OData-Version": "4.0"
        },
        "odata": {
          "fields": [
            {
              "name": "CustomerAccount",
              "title": "Customer account",
              "type": "string"
            },
            {
              "name": "OrganizationName",
              "title": "Name",
              "type": "string"
            },
            {
              "name": "CustomerGroupId",
              "title": "Customer group",
              "type": "string"
            },
            {
              "name": "SalesCurrencyCode",
              "title": "Currency",
              "type": "string"
            },
            {
              "name": "AddressCountryRegionId",
              "title": "Country/region",
              "type": "string"
            },
            {
              "name": "AddressCity",
              "title": "City",
              "type": "string"
            },
            {
              "name": "CreditLimit",
              "title": "Credit limit",
              "type": "number"
            }
          ],
          "company": true,
          "top": 100,
          "orderBy": "CustomerAccount",
          "select": [
            "dataAreaId",
            "CustomerAccount",
            "OrganizationName",
            "CustomerGroupId",
            "SalesCurrencyCode",
            "AddressCountryRegionId",
            "AddressCity",
            "PrimaryContactEmail",
            "PrimaryContactPhone",
            "CreditLimit",
            "PaymentTerms"
          ]
        }
      },
      "formSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "Create customer",
      "description": "Creates a customer (data entity CustomersV3).",
      "icon": "customer",
      "category": "D365 F&O",
      "auth": {
        "type": "module"
      },
      "api": {
        "method": "POST",
        "url": "{{baseUrl}}/data/CustomersV3",
        "headers": {
          "OData-Version": "4.0"
        },
        "successMessage": "Customer {{response.CustomerAccount}} created in {{response.dataAreaId}}."
      },
      "formSchema": {
        "type": "object",
        "required": [
          "dataAreaId",
          "OrganizationName",
          "CustomerGroupId",
          "SalesCurrencyCode"
        ],
        "properties": {
          "dataAreaId": {
            "type": "string",
            "title": "Company",
            "default": "usmf",
            "minLength": 1,
            "maxLength": 4,
            "description": "Legal entity, e.g. usmf"
          },
          "CustomerAccount": {
            "type": "string",
            "title": "Customer account",
            "maxLength": 20,
            "description": "Leave empty when the company gives numbers automatically"
          },
          "OrganizationName": {
            "type": "string",
            "title": "Name",
            "maxLength": 100
          },
          "CustomerGroupId": {
            "type": "string",
            "title": "Customer group",
            "maxLength": 10
          },
          "SalesCurrencyCode": {
            "type": "string",
            "title": "Currency",
            "default": "USD",
            "maxLength": 3
          },
          "PartyType": {
            "type": "string",
            "title": "Party type",
            "enum": [
              "Organization",
              "Person"
            ],
            "default": "Organization"
          },
          "AddressCountryRegionId": {
            "type": "string",
            "title": "Country/region",
            "maxLength": 10
          },
          "AddressStreet": {
            "type": "string",
            "title": "Street"
          },
          "AddressCity": {
            "type": "string",
            "title": "City"
          },
          "AddressZipCode": {
            "type": "string",
            "title": "ZIP/postal code"
          },
          "PrimaryContactEmail": {
            "type": "string",
            "title": "Email",
            "format": "email"
          },
          "PrimaryContactPhone": {
            "type": "string",
            "title": "Phone"
          },
          "PaymentTerms": {
            "type": "string",
            "title": "Terms of payment"
          },
          "CreditLimit": {
            "type": "number",
            "title": "Credit limit",
            "minimum": 0
          }
        }
      },
      "uiSchema": {
        "CustomerGroupId": {
          "ui:placeholder": "e.g. 30"
        },
        "AddressCountryRegionId": {
          "ui:placeholder": "e.g. USA"
        },
        "ui:order": [
          "dataAreaId",
          "CustomerAccount",
          "OrganizationName",
          "CustomerGroupId",
          "SalesCurrencyCode",
          "PartyType",
          "*"
        ]
      }
    },
    {
