            {
              "name": "VendorAccountNumber",
              "title": "Vendor account",
              "type": "string"
            },
            {
              "name": "VendorOrganizationName",
              "title": "Name",
              "type": "string"
            },
            {
              "name": "VendorGroupId",
              "title": "Vendor group",
              "type": "string"
            },
            {
              "name": "CurrencyCode",
              "title": "Currency",
              "type": "string"
            },
            {
              "name": "AddressCountryRegionId",
              "title": "Country/region",
              "type": "string"
            },
            {
              "name": "AddressCity",
              "title": "City",
              "type": "string"
            }
          ],
          "company": true,
          "top": 100,
