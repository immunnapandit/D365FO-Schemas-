# Copy to server/.env for local development. In Azure, set these as app settings / secrets.
# Full reference: docs/deployment.md

# ---------- general ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---------- database ----------
# sqlite = local development only; cosmos = Azure Cosmos DB (NoSQL); mssql = Azure SQL; pg = PostgreSQL
DB_CLIENT=sqlite
# SQLITE_FILE=./data/app.db
# DB_CLIENT=mssql
# DB_HOST=your-server.database.windows.net
# DB_NAME=schemaforms
# DB_AUTH=managed-identity          # or "sql" with DB_USER / DB_PASSWORD
# DB_MANAGED_IDENTITY_CLIENT_ID=    # only for a user-assigned identity
# DB_CLIENT=pg
# DATABASE_URL=postgres://user:pass@host:5432/schemaforms
# DB_CLIENT=cosmos
# COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# COSMOS_DATABASE=schemaforms
# COSMOS_KEY=                         # leave empty to sign in with managed identity / az login
# COSMOS_CREATE_CONTAINERS=true       # default: true with a key, false with managed identity
# COSMOS_MANAGED_IDENTITY_CLIENT_ID=  # only for a user-assigned identity

# ---------- who can use the app ----------
# none = local dev (everyone is admin) | entra = MSAL login | easyauth = App Service / Container Apps Authentication
AUTH_MODE=none
# AUTH_TENANT_ID=
# AUTH_SPA_CLIENT_ID=
# AUTH_API_AUDIENCE=api://<api-app-client-id>,<api-app-client-id>
# AUTH_API_SCOPE=api://<api-app-client-id>/access_as_user
# AUTH_ADMIN_ROLE=SchemaForms.Admin
# AUTH_USER_ROLE=SchemaForms.User
# AUTH_REQUIRE_ROLE=true

# ---------- secrets ----------
# 32 random bytes, base64:  openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# SECRET_ENCRYPTION_KEYS_PREVIOUS=   # only while rotating keys
# KEY_VAULT_URL=https://your-vault.vault.azure.net/

# ---------- outbound calls ----------
ALLOWED_HOSTS=login.microsoftonline.com,*.dynamics.com
REQUEST_TIMEOUT_MS=60000

# Values used by the sample F&O forms ({{env:...}}). Prefer {{kv:...}} in production.
FNO_TENANT_ID=
FNO_CLIENT_ID=
FNO_CLIENT_SECRET=
FNO_BASE_URL=https://your-env.sandbox.operations.dynamics.com

# ---------- optional ----------
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# HISTORY_RETENTION_DAYS=90
# HISTORY_STORE_PAYLOADS=true
# RATE_LIMIT_EXECUTE_PER_MIN=30
# RATE_LIMIT_API_PER_MIN=300
# SEED_SAMPLE_FORMS=true            # adds two starter F&O forms to an empty database (off in production)
